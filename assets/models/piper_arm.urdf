<?xml version="1.0"?>
<!--
  Piper arm URDF for cuRobo motion generation.
  Kinematics converted from assets/models/piper_grav_comp.xml (MuJoCo).
  6 revolute joints (joint1-joint6) + fixed flange_link as EEF frame.
  No mesh geometry; collision handled via piper_arm.xrdf sphere model.
-->
<robot name="piper_arm">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.7"/>
      <inertia ixx="1e-04" ixy="0" ixz="0" iyy="1e-04" iyz="0" izz="1e-04"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.123" rpy="0 0 -1.570801"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.687" upper="2.687" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="0.00131676 0.000310289 -0.00922875" rpy="0 0 0"/>
      <mass value="0.097868"/>
      <inertia ixx="7.767e-05" ixy="1.091e-07" ixz="-1.975e-06"
               iyy="9.250e-05" iyz="9.913e-07" izz="8.246e-05"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.570800 0 -1.570800"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.4" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.148794 -0.00242027 0.00175155" rpy="0 0 0"/>
      <mass value="0.290889"/>
      <inertia ixx="1.490e-04" ixy="-7.377e-05" ixz="-9.687e-07"
               iyy="1.728e-03" iyz="-1.097e-06" izz="1.775e-03"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.28358 0.028726 0" rpy="0 0 0.100950"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.05" upper="0.0" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="-0.0996835 0.0349477 0.000508026" rpy="0 0 0"/>
      <mass value="0.290848"/>
      <inertia ixx="1.079e-04" ixy="2.927e-05" ixz="6.828e-07"
               iyy="2.148e-04" iyz="-7.785e-07" izz="2.419e-04"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="-0.24221 0.068514 0" rpy="-1.570799 0.000001 1.382600"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.85" upper="1.85" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0.000276465 -0.00102804 -0.00472831" rpy="0 0 0"/>
      <mass value="0.127087"/>
      <inertia ixx="3.820e-05" ixy="-4.923e-08" ixz="4.897e-08"
               iyy="4.870e-05" iyz="6.709e-08" izz="4.106e-05"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="1.570801 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.3" upper="1.3" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="8.82262e-05 0.0566829 -0.0019612" rpy="0 0 0"/>
      <mass value="0.144711"/>
      <inertia ixx="4.396e-05" ixy="-3.593e-08" ixz="-1.897e-08"
               iyy="5.632e-05" iyz="-2.154e-07" izz="4.887e-05"/>
    </inertial>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.091 0.001417" rpy="1.570792 0 3.141593"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.75" upper="1.75" effort="100" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- link6 mass includes rigidly attached gripper body (no relative motion) -->
  <link name="link6">
    <inertial>
      <origin xyz="0.0010312 0.0121761 0.0315481" rpy="0 0 0"/>
      <mass value="0.195187"/>
      <inertia ixx="1.543e-04" ixy="0" ixz="0"
               iyy="1.260e-04" iyz="0" izz="6.435e-05"/>
    </inertial>
  </link>

  <!-- EEF frame: fixed to link6 at the gripper mounting plane -->
  <joint name="flange_joint" type="fixed">
    <parent link="link6"/>
    <child link="flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="flange_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
    </inertial>
  </link>

</robot>
